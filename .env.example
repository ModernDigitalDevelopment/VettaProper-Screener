# ---- market data (required) ----
# Polygon.io (rebranded "Massive" in 2026). Options snapshots with greeks
# require a paid OPTIONS plan — a stocks-only plan returns 403.
POLYGON_API_KEY=your_polygon_key_here

# ---- Alpaca (paper by default) ----
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# ---- Interactive Brokers ----
# Requires the Client Portal Gateway running AND authenticated alongside this
# app. Cannot run serverless. See docs/BROKERS.md before relying on this.
IBKR_GATEWAY_URL=https://localhost:5000
IBKR_ACCOUNT_ID=
IBKR_VERIFY_SSL=0

# ---- ARMING FLAGS ----
# Broker adapters are DRY RUN unless these are exactly "1".
# There is deliberately no UI switch for this.
VPS_ALPACA_LIVE=0
VPS_IBKR_LIVE=0

# ---- optional ----
# EVENTS_FILE=backtest/data/events.json
LOG_LEVEL=INFO

# ---- data provider selection ----
# polygon | alpaca | ibkr   (default polygon, falls back to alpaca)
DATA_PROVIDER=polygon
# Alpaca options feed: 'indicative' (15min delayed) or 'opra' (real-time,
# requires accepting the OPRA agreement in the Alpaca dashboard)
ALPACA_OPTIONS_FEED=indicative
